module w12.review_step

// W12: an agent's review step written the way an agent writes it — one call
// after the other. 12 file reads and 4 greps, all independent and read-only.
extern tool read_file(path: Str) -> Result<Str, Str> readonly
extern tool grep(pattern: Str) -> Result<Str, Str> readonly

task review() -> Result<Int, Str> requires tool.read_file, tool.grep {
    let f1 = read_file("q01")?
    let f2 = read_file("q02")?
    let f3 = read_file("q03")?
    let f4 = read_file("q04")?
    let f5 = read_file("q05")?
    let f6 = read_file("q06")?
    let f7 = read_file("q07")?
    let f8 = read_file("q08")?
    let f9 = read_file("q09")?
    let f10 = read_file("q10")?
    let f11 = read_file("q11")?
    let f12 = read_file("q12")?
    let g1 = grep("q13")?
    let g2 = grep("q14")?
    let g3 = grep("q15")?
    let g4 = grep("q16")?
    Ok(len(f1 + f2 + f3 + f4 + f5 + f6 + f7 + f8 + f9 + f10 + f11 + f12 + g1 + g2 + g3 + g4))
}
