module w9.static_chain10

extern tool dispatch(tool: Str, node: Str, input: Str) -> Result<Str, Str>

// One retried tool call per node, as run_node in scheduler/dag.zal.
task node(tool: Str, id: Str, input: Str, max_attempts: Int) -> Result<Str, Str> requires tool.dispatch {
    retry(max_attempts) { dispatch(tool, id, input) }
}

workflow run_static() -> Result<Int, Str> requires tool.dispatch {
    let (o_0_0_r) = parallel {
        node("build", "n0_0", "in0_0", 3)
    }
    let o_0_0 = o_0_0_r?
    let (o_1_0_r) = parallel {
        node("build", "n1_0", "in1_0" + "|" + o_0_0, 3)
    }
    let o_1_0 = o_1_0_r?
    let (o_2_0_r) = parallel {
        node("build", "n2_0", "in2_0" + "|" + o_1_0, 3)
    }
    let o_2_0 = o_2_0_r?
    let (o_3_0_r) = parallel {
        node("build", "n3_0", "in3_0" + "|" + o_2_0, 3)
    }
    let o_3_0 = o_3_0_r?
    let (o_4_0_r) = parallel {
        node("build", "n4_0", "in4_0" + "|" + o_3_0, 3)
    }
    let o_4_0 = o_4_0_r?
    let (o_5_0_r) = parallel {
        node("build", "n5_0", "in5_0" + "|" + o_4_0, 3)
    }
    let o_5_0 = o_5_0_r?
    let (o_6_0_r) = parallel {
        node("build", "n6_0", "in6_0" + "|" + o_5_0, 3)
    }
    let o_6_0 = o_6_0_r?
    let (o_7_0_r) = parallel {
        node("build", "n7_0", "in7_0" + "|" + o_6_0, 3)
    }
    let o_7_0 = o_7_0_r?
    let (o_8_0_r) = parallel {
        node("build", "n8_0", "in8_0" + "|" + o_7_0, 3)
    }
    let o_8_0 = o_8_0_r?
    let (o_9_0_r) = parallel {
        node("build", "n9_0", "in9_0" + "|" + o_8_0, 3)
    }
    let o_9_0 = o_9_0_r?
    Ok(10)
}
