module w9.static_g4x6

extern tool dispatch(tool: Str, node: Str, input: Str) -> Result<Str, Str>

// One retried tool call per node, as run_node in scheduler/dag.zal.
task node(tool: Str, id: Str, input: Str, max_attempts: Int) -> Result<Str, Str> requires tool.dispatch {
    retry(max_attempts) { dispatch(tool, id, input) }
}

workflow run_static() -> Result<Int, Str> requires tool.dispatch {
    let (o_0_0_r, o_0_1_r, o_0_2_r, o_0_3_r, o_0_4_r, o_0_5_r) = parallel {
        node("build", "n0_0", "in0_0", 3)
        node("test", "n0_1", "in0_1", 3)
        node("security_scan", "n0_2", "in0_2", 3)
        node("preview", "n0_3", "in0_3", 3)
        node("build", "n0_4", "in0_4", 3)
        node("test", "n0_5", "in0_5", 3)
    }
    let o_0_0 = o_0_0_r?
    let o_0_1 = o_0_1_r?
    let o_0_2 = o_0_2_r?
    let o_0_3 = o_0_3_r?
    let o_0_4 = o_0_4_r?
    let o_0_5 = o_0_5_r?
    let (o_1_0_r, o_1_1_r, o_1_2_r, o_1_3_r, o_1_4_r, o_1_5_r) = parallel {
        node("build", "n1_0", "in1_0" + "|" + o_0_0 + "|" + o_0_1, 3)
        node("test", "n1_1", "in1_1" + "|" + o_0_1 + "|" + o_0_2, 3)
        node("security_scan", "n1_2", "in1_2" + "|" + o_0_2 + "|" + o_0_3, 3)
        node("preview", "n1_3", "in1_3" + "|" + o_0_3 + "|" + o_0_4, 3)
        node("build", "n1_4", "in1_4" + "|" + o_0_4 + "|" + o_0_5, 3)
        node("test", "n1_5", "in1_5" + "|" + o_0_5 + "|" + o_0_0, 3)
    }
    let o_1_0 = o_1_0_r?
    let o_1_1 = o_1_1_r?
    let o_1_2 = o_1_2_r?
    let o_1_3 = o_1_3_r?
    let o_1_4 = o_1_4_r?
    let o_1_5 = o_1_5_r?
    let (o_2_0_r, o_2_1_r, o_2_2_r, o_2_3_r, o_2_4_r, o_2_5_r) = parallel {
        node("build", "n2_0", "in2_0" + "|" + o_1_0 + "|" + o_1_1, 3)
        node("test", "n2_1", "in2_1" + "|" + o_1_1 + "|" + o_1_2, 3)
        node("security_scan", "n2_2", "in2_2" + "|" + o_1_2 + "|" + o_1_3, 3)
        node("preview", "n2_3", "in2_3" + "|" + o_1_3 + "|" + o_1_4, 3)
        node("build", "n2_4", "in2_4" + "|" + o_1_4 + "|" + o_1_5, 3)
        node("test", "n2_5", "in2_5" + "|" + o_1_5 + "|" + o_1_0, 3)
    }
    let o_2_0 = o_2_0_r?
    let o_2_1 = o_2_1_r?
    let o_2_2 = o_2_2_r?
    let o_2_3 = o_2_3_r?
    let o_2_4 = o_2_4_r?
    let o_2_5 = o_2_5_r?
    let (o_3_0_r, o_3_1_r, o_3_2_r, o_3_3_r, o_3_4_r, o_3_5_r) = parallel {
        node("build", "n3_0", "in3_0" + "|" + o_2_0 + "|" + o_2_1, 3)
        node("test", "n3_1", "in3_1" + "|" + o_2_1 + "|" + o_2_2, 3)
        node("security_scan", "n3_2", "in3_2" + "|" + o_2_2 + "|" + o_2_3, 3)
        node("preview", "n3_3", "in3_3" + "|" + o_2_3 + "|" + o_2_4, 3)
        node("build", "n3_4", "in3_4" + "|" + o_2_4 + "|" + o_2_5, 3)
        node("test", "n3_5", "in3_5" + "|" + o_2_5 + "|" + o_2_0, 3)
    }
    let o_3_0 = o_3_0_r?
    let o_3_1 = o_3_1_r?
    let o_3_2 = o_3_2_r?
    let o_3_3 = o_3_3_r?
    let o_3_4 = o_3_4_r?
    let o_3_5 = o_3_5_r?
    Ok(24)
}
