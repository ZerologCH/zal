module w9.static_t6x3

extern tool dispatch(tool: Str, node: Str, input: Str) -> Result<Str, Str>

// One retried tool call per node, as run_node in scheduler/dag.zal.
task node(tool: Str, id: Str, input: Str, max_attempts: Int) -> Result<Str, Str> requires tool.dispatch {
    retry(max_attempts) { dispatch(tool, id, input) }
}

workflow run_static() -> Result<Int, Str> requires tool.dispatch {
    let (o_0_0_r, o_0_1_r, o_0_2_r) = parallel {
        node("build", "n0_0", "in0_0", 3)
        node("test", "n0_1", "in0_1", 3)
        node("security_scan", "n0_2", "in0_2", 3)
    }
    let o_0_0 = o_0_0_r?
    let o_0_1 = o_0_1_r?
    let o_0_2 = o_0_2_r?
    let (o_1_0_r, o_1_1_r, o_1_2_r) = parallel {
        node("build", "n1_0", "in1_0" + "|" + o_0_0 + "|" + o_0_1 + "|" + o_0_2, 3)
        node("test", "n1_1", "in1_1" + "|" + o_0_1 + "|" + o_0_2 + "|" + o_0_0, 3)
        node("security_scan", "n1_2", "in1_2" + "|" + o_0_2 + "|" + o_0_0 + "|" + o_0_1, 3)
    }
    let o_1_0 = o_1_0_r?
    let o_1_1 = o_1_1_r?
    let o_1_2 = o_1_2_r?
    let (o_2_0_r, o_2_1_r, o_2_2_r) = parallel {
        node("build", "n2_0", "in2_0" + "|" + o_1_0 + "|" + o_1_1 + "|" + o_1_2, 3)
        node("test", "n2_1", "in2_1" + "|" + o_1_1 + "|" + o_1_2 + "|" + o_1_0, 3)
        node("security_scan", "n2_2", "in2_2" + "|" + o_1_2 + "|" + o_1_0 + "|" + o_1_1, 3)
    }
    let o_2_0 = o_2_0_r?
    let o_2_1 = o_2_1_r?
    let o_2_2 = o_2_2_r?
    let (o_3_0_r, o_3_1_r, o_3_2_r) = parallel {
        node("build", "n3_0", "in3_0" + "|" + o_2_0 + "|" + o_2_1 + "|" + o_2_2, 3)
        node("test", "n3_1", "in3_1" + "|" + o_2_1 + "|" + o_2_2 + "|" + o_2_0, 3)
        node("security_scan", "n3_2", "in3_2" + "|" + o_2_2 + "|" + o_2_0 + "|" + o_2_1, 3)
    }
    let o_3_0 = o_3_0_r?
    let o_3_1 = o_3_1_r?
    let o_3_2 = o_3_2_r?
    let (o_4_0_r, o_4_1_r, o_4_2_r) = parallel {
        node("build", "n4_0", "in4_0" + "|" + o_3_0 + "|" + o_3_1 + "|" + o_3_2, 3)
        node("test", "n4_1", "in4_1" + "|" + o_3_1 + "|" + o_3_2 + "|" + o_3_0, 3)
        node("security_scan", "n4_2", "in4_2" + "|" + o_3_2 + "|" + o_3_0 + "|" + o_3_1, 3)
    }
    let o_4_0 = o_4_0_r?
    let o_4_1 = o_4_1_r?
    let o_4_2 = o_4_2_r?
    let (o_5_0_r, o_5_1_r, o_5_2_r) = parallel {
        node("build", "n5_0", "in5_0" + "|" + o_4_0 + "|" + o_4_1 + "|" + o_4_2, 3)
        node("test", "n5_1", "in5_1" + "|" + o_4_1 + "|" + o_4_2 + "|" + o_4_0, 3)
        node("security_scan", "n5_2", "in5_2" + "|" + o_4_2 + "|" + o_4_0 + "|" + o_4_1, 3)
    }
    let o_5_0 = o_5_0_r?
    let o_5_1 = o_5_1_r?
    let o_5_2 = o_5_2_r?
    Ok(18)
}
