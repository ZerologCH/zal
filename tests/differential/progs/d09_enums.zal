module d09

enum Color { Red, Green, Blue }
enum Shape { Dot, Circle(Int), Label(Str), Pair(Point2) }
type Point2 = { x: Int, y: Int }
enum Wrap { W(Shape), Nothing }
enum Tree { Leaf, Node(List<Int>) }

fn code(c: Color) -> Int { match c { Color.Red => 1, Color.Green => 2, Color.Blue => 3 } }
fn area(s: Shape) -> Int {
    match s {
        Shape.Dot => 0,
        Shape.Circle(r) => 3 * r * r,
        Shape.Label(l) => len(l),
        Shape.Pair(p) => p.x * p.y,
    }
}
fn is_dot(s: Shape) -> Bool { match s { Shape.Dot => true, _ => false } }
fn unwrap(w: Wrap) -> Int { match w { Wrap.W(s) => area(s), Wrap.Nothing => -1 } }
fn next(c: Color) -> Color { match c { Color.Red => Color.Green, Color.Green => Color.Blue, Color.Blue => Color.Red } }
fn payload_ignored(s: Shape) -> Int { match s { Shape.Circle(_) => 1, _ => 0 } }
fn tree_sum(t: Tree) -> Int {
    match t {
        Tree.Leaf => 0,
        Tree.Node(xs) => { let mut s = 0
            for x in xs { s = s + x }
            s },
    }
}

task t_code(c: Color) -> Int { code(c) }
task t_area(s: Shape) -> Int { area(s) }
task t_is_dot(s: Shape) -> Bool { is_dot(s) }
task t_unwrap(w: Wrap) -> Int { unwrap(w) }
task t_next(c: Color) -> Color { next(c) }
task t_make() -> List<Shape> { [Shape.Dot, Shape.Circle(2), Shape.Label("hi"), Shape.Pair(Point2 { x: 2, y: 5 })] }
task t_wrap() -> List<Wrap> { [Wrap.W(Shape.Circle(1)), Wrap.Nothing] }
task t_eq() -> List<Bool> { [Color.Red == Color.Red, Color.Red == Color.Blue, Shape.Circle(1) == Shape.Circle(1)] }
task t_ignored(s: Shape) -> Int { payload_ignored(s) }
task t_tree(t: Tree) -> Int { tree_sum(t) }
task t_enum_map() -> Map<Color> { map_set(map_new(), "c", Color.Blue) }
