module d12

fn fib(n: Int) -> Int { if n < 2 { n } else { fib(n - 1) + fib(n - 2) } }
fn is_even(n: Int) -> Bool { if n == 0 { true } else { is_odd(n - 1) } }
fn is_odd(n: Int) -> Bool { if n == 0 { false } else { is_even(n - 1) } }
fn depth(n: Int) -> Int { if n == 0 { 0 } else { 1 + depth(n - 1) } }
fn gcd(a: Int, b: Int) -> Int { if b == 0 { a } else { gcd(b, a % b) } }
fn pow(b: Int, e: Int) -> Int { if e == 0 { 1 } else { b * pow(b, e - 1) } }
fn early(n: Int) -> Int { if n > 3 { return 100 }
    n }
fn compose(n: Int) -> Int { early(gcd(pow(2, n), 12)) }
fn unit_fn() { print("unit") }
fn sum_to(n: Int, acc: Int) -> Int { if n == 0 { acc } else { sum_to(n - 1, acc + n) } }

task leaf(n: Int) -> Int { n + 1 }
task mid(n: Int) -> Int { leaf(leaf(n)) * 2 }
task top(n: Int) -> Int { mid(n) + mid(n + 1) }
workflow wf(n: Int) -> Int { top(n) + 1 }

task t_fib(n: Int) -> Int { fib(n) }
task t_even(n: Int) -> Bool { is_even(n) }
task t_depth(n: Int) -> Int { depth(n) }
task t_gcd(a: Int, b: Int) -> Int { gcd(a, b) }
task t_compose(n: Int) -> Int { compose(n) }
task t_unit() -> Unit { unit_fn() }
task t_sum_to(n: Int) -> Int { sum_to(n, 0) }
task t_top(n: Int) -> Int { top(n) }
workflow t_wf(n: Int) -> Int { wf(n) }
