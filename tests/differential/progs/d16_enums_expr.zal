module d16

enum Color { Red, Green, Blue }
enum Shape { Dot, Circle(Int), Label(Str), Pair(Point2) }
type Point2 = { x: Int, y: Int }
enum Wrap { W(Shape), Nothing }
enum Tree { Leaf, Node(List<Int>) }

fn ids(s: Shape) -> Shape { s }
fn idc(c: Color) -> Color { c }
fn idw(w: Wrap) -> Wrap { w }
fn idt(t: Tree) -> Tree { t }

fn code(c: Color) -> Int { match idc(c) { Color.Red => 1, Color.Green => 2, Color.Blue => 3 } }
fn area(s: Shape) -> Int {
    match ids(s) {
        Shape.Dot => 0,
        Shape.Circle(r) => 3 * r * r,
        Shape.Label(l) => len(l),
        Shape.Pair(p) => p.x * p.y,
    }
}
fn is_dot(s: Shape) -> Bool { match ids(s) { Shape.Dot => true, _ => false } }
fn unwrap(w: Wrap) -> Int { match idw(w) { Wrap.W(s) => area(s), Wrap.Nothing => -1 } }
fn next(c: Color) -> Color { match idc(c) { Color.Red => Color.Green, Color.Green => Color.Blue, Color.Blue => Color.Red } }
fn payload_ignored(s: Shape) -> Int { match ids(s) { Shape.Circle(_) => 1, _ => 0 } }
fn tree_sum(t: Tree) -> Int {
    match idt(t) {
        Tree.Leaf => 0,
        Tree.Node(xs) => { let mut s = 0
            for x in xs { s = s + x }
            s },
    }
}

fn col(n: Int) -> Color { match idi(n) { 0 => Color.Red, 1 => Color.Green, _ => Color.Blue } }
fn shp(n: Int) -> Shape { match idi(n) { 0 => Shape.Dot, 1 => Shape.Circle(2), 2 => Shape.Label("hello"), _ => Shape.Pair(Point2 { x: 3, y: 4 }) } }
fn idi(n: Int) -> Int { n }

task t_code(n: Int) -> Int { code(col(n)) }
task t_area(n: Int) -> Int { area(shp(n)) }
task t_is_dot(n: Int) -> Bool { is_dot(shp(n)) }
task t_unwrap(n: Int) -> Int { if n < 0 { unwrap(Wrap.Nothing) } else { unwrap(Wrap.W(shp(n))) } }
task t_next(n: Int) -> Color { next(col(n)) }
task t_make() -> List<Shape> { [Shape.Dot, Shape.Circle(2), Shape.Label("hi"), Shape.Pair(Point2 { x: 2, y: 5 })] }
task t_wrap() -> List<Wrap> { [Wrap.W(Shape.Circle(1)), Wrap.Nothing] }
task t_eq() -> List<Bool> { [Color.Red == Color.Red, Color.Red == Color.Blue, Shape.Circle(1) == Shape.Circle(1)] }
task t_ignored(n: Int) -> Int { payload_ignored(shp(n)) }
task t_tree(n: Int) -> Int { if n < 0 { tree_sum(Tree.Leaf) } else { tree_sum(Tree.Node(range(n))) } }
task t_enum_map() -> Map<Color> { map_set(map_new(), "c", Color.Blue) }
